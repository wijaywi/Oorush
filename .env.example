# The current binaries accept these values as command-line arguments. This file
# documents the reproducible deployment settings without containing secrets.
OORUSH_LISTEN=127.0.0.1:18444
OORUSH_HTTP_LISTEN=127.0.0.1:18445
OORUSH_STATE=/data/node-chain.json
OORUSH_WALLET=/data/node-wallet.json
OORUSH_INITIAL_BALANCE=1000000

# Netlify-only dashboard setting. This must be a separately hosted HTTPS,
# read-only gateway; never point it at a loopback TCP node or put secrets here.
OORUSH_STATUS_URL=https://your-status-gateway.example/oorush/status
